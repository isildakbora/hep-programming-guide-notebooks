+import json
+from pathlib import Path
+
+ROOT = 'https://opendata.cern.ch/eos/opendata/cms/Run2016G/DoubleMuon/NANOAOD/UL2016_MiniAODv2_NanoAODv9-v2/2430000/4E3A26DE-E53B-A844-8048-36376617AE8D.root'
+GOLDEN = 'https://opendata.cern.ch/eos/opendata/cms/validated-runs/2016/Cert_271036-284044_13TeV_Legacy2016_Collisions16_JSON.txt'
+TABLE = 'https://www.hepdata.net/record/data/149577/1643683/1/'
+
+def update(path, cells):
+    p = Path(path)
+    n = json.loads(p.read_text())
+    for i, source in cells.items():
+        n['cells'][i]['source'] = source.splitlines(keepends=True)
+    for c in n['cells']:
+        if c['cell_type'] == 'code':
+            c['outputs'] = []
+            c['execution_count'] = None
+    p.write_text(json.dumps(n, ensure_ascii=False, indent=1) + '\n')
+
+ex01_intro = '''Exercise 1.4 Exploring open data. Inspect the CMS [DoubleMuon Run2016G NanoAODv9 dataset](https://opendata.cern.ch/record/30522) using uproot. The selected ROOT file is 66,090,536 bytes. Find the `Events` TTree, list branch names and types, and estimate stored bytes per event by dividing file size by entries. The download falls back to a clearly labelled synthetic file only if it fails.
+
+<details><summary>Hint</summary>
+
+Call `tree.show()` or inspect `tree.keys()` and `tree[name].typename`. The file size includes metadata and compression; this ratio is only an estimate.
+
+</details>'''
+ex01_load = f'''import numpy as np, uproot
+from pathlib import Path
+import tempfile, urllib.request
+
+DATA_URL = "{ROOT}"
+path = Path(tempfile.gettempdir()) / "cms_run2016g_doublemuon_4E3A26DE.root"
+source = "CMS Run2016G DoubleMuon NanoAODv9"
+try:
+    if not path.exists() or path.stat().st_size != 66090536:
+        with urllib.request.urlopen(DATA_URL, timeout=90) as response, path.open("wb") as target:
+            while chunk := response.read(1024 * 1024):
+                target.write(chunk)
+    if path.stat().st_size != 66090536:
+        raise OSError("incomplete CMS download")
+    with uproot.open(path) as root_file:
+        assert "Events" in root_file
+except (OSError, TimeoutError, urllib.error.URLError) as exc:
+    print(f"CMS download failed ({{exc}}); using synthetic fallback, not CERN data.")
+    source = "synthetic fallback"
+    path = Path(tempfile.gettempdir()) / "exercise_1_4_synthetic.root"
+    rng = np.random.default_rng(42)
+    with uproot.recreate(path) as root_file:
+        root_file["Events"] = {{"run": np.full(500, 1, dtype=np.uint32),
+                               "luminosityBlock": np.ones(500, dtype=np.uint32),
+                               "Muon_pt": rng.exponential(35, 500).astype(np.float32),
+                               "Muon_eta": rng.normal(0, 1, 500).astype(np.float32)}}
+print("Source:", source)
+'''
+update('ch01/ex01_4.ipynb', {
+    1: ex01_intro,
+    3: '### Load the public CMS ROOT file',
+    4: ex01_load,
+    5: '''with uproot.open(path) as root_file:
+    print("TTrees:", root_file.keys())
+    tree = root_file["Events"]
+    # TODO: show the tree, inspect branch names and types (e.g. run, luminosityBlock, Muon_pt, Muon_eta).
+    # TODO: compute stored bytes per event from path.stat().st_size and tree.num_entries.
+    bytes_per_event = None
+print("bytes/event:", bytes_per_event)'''
+})
+update('ch01/ex01_4_solution.ipynb', {
+    1: ex01_intro,
+    3: '### Load the public CMS ROOT file',
+    4: ex01_load,
+    5: '''with uproot.open(path) as root_file:
+    print("TTrees:", root_file.keys())
+    tree = root_file["Events"]
+    branch_names = list(tree.keys())
+    branch_types = {name: tree[name].typename for name in ["run", "luminosityBlock", "Muon_pt", "Muon_eta", "Muon_phi", "Muon_charge"] if name in tree}
+    entries = tree.num_entries
+bytes_per_event = path.stat().st_size / entries
+print("Branches (first 12):", branch_names[:12])
+print("Selected branch types:", branch_types)
+print(f"{entries} events, {path.stat().st_size} bytes, {bytes_per_event:.1f} stored bytes/event")
+assert entries > 0 and bytes_per_event > 0''',
+    6: '''### Interpretation
+
+For the CMS file, `Events` contains `run`, `luminosityBlock`, and jagged muon branches such as `Muon_pt`, `Muon_eta`, `Muon_phi`, and `Muon_charge`. File bytes divided by entries includes metadata and compression, so it approximates stored bytes per event. If the download failed, the printed source identifies a synthetic fallback; its result is not a CMS measurement.'''
+})
+
+paper = '''### Recreate a published CMS Higgs transverse-momentum spectrum
+
+CMS, *Measurement of the Production Cross Section of a Higgs Boson with Large Transverse Momentum in Its Decays to a Pair of $\\tau$ Leptons in Proton-Proton Collisions at $\\sqrt{s}$ = 13 TeV* ([arXiv:2403.20201](https://arxiv.org/abs/2403.20201), DOI: 10.1016/j.physletb.2024.138964). Use HEPData [record 149577](https://www.hepdata.net/record/149577), exact table `Diff XS v.s. Higgs pt`. Its observed distribution has four bins from 250 to 2000 GeV. The table headers are `p_{T}^{H} [GeV]` and `Observed [fb/GeV]`.'''
+update('ch04/ex04_2.ipynb', {
+    3: paper,
+    4: f'''import numpy as np
+import matplotlib.pyplot as plt
+import mplhep as hep
+TABLE_URL = "{TABLE}"
+# TODO: fetch the HEPData single-table JSON. Its bins are in rows["values"][i]["x"][0]
+#       as "low"/"high"; observed measurements are in ["y"][0].
+# TODO: extract values and total errors, then plot with CMS style.
+# If the network is unavailable, print a clear message and leave this cell ready to rerun.'''
+})
+sol04 = f'''import json, urllib.request
