'', 'value': 'CMS'}, {'name': 'phrases', 'synonyms': '', 'value': 'Proton-Proton'}, {'name': 'phrases', 'synonyms': '', 'value': 'Higgs'}, {'name': 'phrases', 'synonyms': '', 'value': 'combination'}, {'name': 'phrases', 'synonyms': '', 'value': 'differential'}], 'last_updated': '2019-07-29T10:48:36', 'parent_child_join': {'name': 'child_datatable', 'parent': '89936'}, 'recid': 90707, 'related_publication': 89936, 'resources': [{'description': 'Image', 'type': 'png', 'url': 'https://www.hepdata.net/record/resource/944295?landing_page=true'}, {'description': 'Thumbnail', 'type': 'png', 'url': 'https://www.hepdata.net/record/resource/944296?landing_page=true'}, {'description': 'PNG format', 'type': 'html', 'url': 'http://cms-results.web.cern.ch/cms-results/public-results/publications/HIG-17-028/CMS-HIG-17-028_Figure_005.png'}, {'description': 'PDF format', 'type': 'html', 'url': 'http://cms-results.web.cern.ch/cms-results/public-results/publications/HIG-17-028/CMS-HIG-17-028_Figure_005.pdf'}], 'title': 'Figure 5 ($H\\rightarrow\\gamma\\gamma$)', 'uuid': '0adf0bf6-f4f4-4c0d-bda7-69755905d6ae'}, {'abstract': 'Leading jet transverse momentum spectrum, $H\\rightarrow ZZ$', 'access_urls': {'links': {'csv': 'https://www.hepdata.net/download/table/ins1709330/Figure 5 ($H%5Crightarrow ZZ$)/csv', 'json': 'https://www.hepdata.net/download/table/ins1709330/Figure 5 ($H%5Crightarrow ZZ$)/json', 'root': 'https://www.hepdata.net/download/table/ins1709330/Figure 5 ($H%5Crightarrow ZZ$)/root', 'yaml': 'https://www.hepdata.net/download/table/ins1709330/Figure 5 ($H%5Crightarrow ZZ$)/yaml', 'yoda': 'https://www.hepdata.net/download/table/ins1709330/Figure 5 ($H%5Crightarrow ZZ$)/yoda', 'yoda-h5': 'https://www.hepdata.net/download/table/ins1709330/Figure 5 ($H%5Crightarrow ZZ$)/yoda.h5'}}, 'authors': None, 'collaborations': ['CMS'], 'control_number': '90708', 'creation_date': '2018-12-16', 'data_keywords': {'cmenergies': [{'gte': 13000.0, 'lte': 13000.0}], 'phrases': ['Proton-Proton', 'combination', 'LHC', 'CMS', 'Higgs', 'differential'], 'reactions': ['H --> Z Z', 'P P --> H']}, 'date': '16 Dec 2018', 'doc_type': 'datatable', 'doi': '10.17182/hepdata.89936.v1/t14', 'first_author': {'affiliation': 'Yerevan Phys. Inst.', 'full_name': 'Sirunyan, Albert M'}, 'id': 90708, 'inspire_id': '1709330', 'journal_info': 'Phys.Lett.B 792 (2019) 369-396', 'keywords': [{'name': 'reactions', 'synonyms': '', 'value': 'P P --> H'}, {'name': 'reactions', 'synonyms': '', 'value': 'H --> Z Z'}, {'name': 'cmenergies', 'synonyms': '', 'value': '13000.0'}, {'name': 'phrases', 'synonyms': '', 'value': 'LHC'}, {'name': 'phrases', 'synonyms': '', 'value': 'CMS'}, {'name': 'phrases', 'synonyms': '', 'value': 'Proton-Proton'}, {'name': 'phrases', 'synonyms': '', 'value': 'Higgs'}, {'name': 'phrases', 'synonyms': '', 'value': 'combination'}, {'name': 'phrases', 'synonyms': '', 'value': 'differential'}], 'last_updated': '2019-07-29T10:48:36', 'parent_child_join': {'name': 'child_datatable', 'parent': '89936'}, 'recid': 90708, 'related_publication': 89936, 'resources': [{'description': 'Image', 'type': 'png', 'url': 'https://www.hepdata.net/record/resource/944300?landing_page=true'}, {'description': 'Thumbnail', 'type': 'png', 'url': 'https://www.hepdata.net/record/resource/944301?landing_page=true'}, {'description': 'PNG format', 'type': 'html', 'url': 'http://cms-results.web.cern.ch/cms-results/public-results/publications/HIG-17-028/CMS-HIG-17-028_Figure_005.png'}, {'description': 'PDF format', 'type': 'html', 'url': 'http://cms-results.web.cern.ch/cms-results/public-results/publications/HIG-17-028/CMS-HIG-17-028_Figure_005.pdf'}], 'title': 'Figure 5 ($H\\rightarrow ZZ$)', 'uuid': '91b106b0-883c-4788-a7b5-6e1dd69ad696'}], 'data_abstract': 'Differential Higgs boson ($H$) production cross sections are sensitive probes for physics beyond the standard model. New physics may contribute in the gluon-gluon fusion loop, the dominant Higgs boson production mechanism at the LHC, and manifest itself through deviations from the distributions predicted by the standard model. Combined spectra for the $H\\to\\gamma\\gamma$, $H\\to ZZ$, and $H\\to b \\overline{b}$ decay channels and the inclusive Higgs boson production cross section are presented, based on proton-proton collision data recorded with the CMS detector at $\\sqrt{s}=13$\\TeV corresponding to an integrated luminosity of 35.9 fb${}^{-1}$. The transverse momentum spectrum is used to place limits on the Higgs boson couplings to the top, bottom, and charm quarks, as well as its direct coupling to the gluon field. No significant deviations from the standard model are observed in any differential distribution. The measured total cross section is $61.1\\pm 6.0 \\text{(stat)} \\pm 3.7 \\text{(syst)}$ pb, and the precision of the measurement of the differential cross section of the Higgs boson transverse momentum is improved by about 15% with respect to the $H\\to\\gamma\\gamma$ channel alone.', 'data_keywords': {'cmenergies': [{'gte': 13000.0, 'lte': 13000.0}], 'phrases': ['Proton-Proton', 'combination', 'LHC', 'CMS', 'Higgs', 'differential', 'diphoton'], 'reactions': ['H --> GAMMA GAMMA', 'P P --> H', 'H --> Z Z', 'H --> B B']}, 'date': '16 Dec 2018', 'doc_type': 'publication', 'doi': '10.1016/j.physletb.2019.03.059', 'first_author': {'affiliation': 'Yerevan Phys. Inst.', 'full_name': 'Sirunyan, Albert M'}, 'hepdata_doi': '10.17182/hepdata.89936', 'id': 89936, 'inspire_id': '1709330', 'journal_info': 'Phys.Lett.B 792 (2019) 369-396', 'keywords': [{'source': 'author', 'value': 'Differential cross sections'}, {'source': 'author', 'value': 'Combination'}, {'source': 'author', 'value': 'Higgs boson coupling modifiers'}, {'schema': 'INSPIRE', 'value': 'p p: colliding beams'}, {'schema': 'INSPIRE', 'value': 'Higgs particle: hadroproduction'}, {'schema': 'INSPIRE', 'value': 'Higgs particle: decay modes'}, {'schema': 'INSPIRE', 'value': 'photon: pair production'}, {'schema': 'INSPIRE', 'value': 'Z0: pair pr