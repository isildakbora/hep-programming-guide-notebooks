/bin/zsh -lc "rtk env PYTHONPATH=/tmp/hep_url_deps python - <<'PY'
import requests,uproot,awkward as ak,numpy as np,vector
m=requests.get('https://opendata.cern.ch/api/records/30522').json()['metadata'];f=min([f for a in m['_file_indices'] for f in a['files']],key=lambda x:x['size']);u=f['uri'].replace('root://eospublic.cern.ch//','https://opendata.cern.ch/');g=requests.get('https://opendata.cern.ch/eos/opendata/cms/validated-runs/2016/Cert_271036-284044_13TeV_Legacy2016_Collisions16_JSON.txt').json();print('golden runs',len(g));a=uproot.open(u)['Events'].arrays(['Muon_pt','Muon_eta','Muon_phi','Muon_charge','Muon_tightId','run','luminosityBlock'],entry_stop=200000,library='ak');print('events',len(a));mask=np.fromiter((any(lo<=int(ls)<=hi for lo,hi in g.get(str(int(r)),[])) for r,ls in zip(a.run,a.luminosityBlock)),dtype=bool,count=len(a));print('cert',mask.sum());a=a[mask];vector.register_awkward();mu=ak.zip({'pt':a.Muon_pt,'eta':a.Muon_eta,'phi':a.Muon_phi,'mass':ak.ones_like(a.Muon_pt)*0.105658,'charge':a.Muon_charge,'tight':a.Muon_tightId},with_name='Momentum4D');mu=mu[(mu.pt>25)&(abs(mu.eta)<2.4)&mu.tight];mu=mu[ak.num(mu)>=2];mu=mu[ak.argsort(mu.pt,axis=1,ascending=False)];mu=mu[:,:2];mu=mu[mu[:,0].charge*mu[:,1].charge<0];mass=ak.to_numpy((mu[:,0]+mu[:,1]).mass);mass=mass[(mass>70)&(mass<110)];print('selected',len(mass),'mean',mass.mean() if len(mass) else None)
